rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Private per-user data: progress, settings, team membership.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /teams/{teamId} {
      function signedIn() { return request.auth != null; }
      function isCoach() {
        return signedIn() && get(/databases/$(database)/documents/teams/$(teamId)).data.coachUid == request.auth.uid;
      }
      function isMember() {
        return signedIn() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      }
      function inTeam() { return isCoach() || isMember(); }

      // A team doc holds only the name, goal and settings, so anyone with the code can look it up to join.
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.coachUid == request.auth.uid;
      allow update: if isCoach() && request.resource.data.coachUid == resource.data.coachUid;

      // Roster entries contain NO name or minutes, only that someone joined.
      match /members/{memberId} {
        allow read: if inTeam();
        allow create, delete: if signedIn() && request.auth.uid == memberId;
      }

      // Anonymous weekly totals: minutes plus random per-membership ids. No names, no uids.
      match /weeks/{weekId} {
        allow read: if inTeam();
        allow create, update: if isMember();
      }

      // Named activity, written only by athletes who opted in. Others may add or remove their own kudos only.
      match /activity/{activityId} {
        allow read: if inTeam();
        allow create: if isMember() && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow update: if isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kudosFrom']);
      }

      // Opt-in minutes list. Doc id is "<weekKey>_<uid>" and only that user can write it.
      match /leaderboard/{rowId} {
        allow read: if inTeam();
        allow create, update: if isMember() && request.resource.data.uid == request.auth.uid
          && rowId.matches('.*_' + request.auth.uid);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
